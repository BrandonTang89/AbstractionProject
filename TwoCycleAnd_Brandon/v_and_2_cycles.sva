// =====================================================================
// Simple 3-input, unit-delay AND gate example to illustrate rSTE.
//
// Module containing all verification properties. 
// =====================================================================

module and_2_cycles_spec #()
(
 input logic  clk,
 input logic  a,b,c,
 input logic o            // Note - the output in the DUT becomes an input here
);

// Clocking - specify the clocking of the properties. Basically, when do you "look"?
default clocking @(posedge clk); endclocking

// Example of wrong property
and_wrong:
  assert property
    (##2 o == ($past(a, 1) & $past(b, 1) & $past(c, 1) & $past(a, 2) & $past(b, 2)));

and_correct:
  assert property
    (##2 o == ($past(a, 1) & $past(b, 1) & $past(c, 1) & $past(a, 2) & $past(b, 2) & $past(c, 2)));


endmodule // and_spec

