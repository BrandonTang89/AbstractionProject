// =====================================================================
// Module containing all verification properties. 
// =====================================================================

module cam_spec #(
    parameter DATA_WIDTH = 8,
    parameter ADDR_WIDTH = 4
)(
    input logic clk,                       // Clock signal
    input logic [DATA_WIDTH-1:0] query,    // Query value
    input logic trigger,                   // Trigger signal
    input logic hit,                       // Hit signal
    input logic [DATA_WIDTH-1:0] mem [(2**ADDR_WIDTH)-1:0] // Memory array
);

    // Clocking block
    default clocking @(posedge clk); endclocking

    // Temporary variable to store the result of the memory search
    logic found;
    logic found_prev;

    // Procedural block to check if the memory contains the query string
    always_ff @(posedge clk) begin
        if (trigger) begin
            found = 0;
            for (int i = 0; i < (2**ADDR_WIDTH); i++) begin
                if (mem[i] == query) begin
                    found = 1;
                end
            end
        end
        found_prev <= found;  // Update found_prev on every clock cycle
    end

    // Assertion to check if the hit signal is correctly set based on the memory search
    assert_hit:
        assert property (trigger |=> (hit == found_prev));

endmodule